{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "tiennd-shop-admin",
    "public": "dist/shop-admin/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
